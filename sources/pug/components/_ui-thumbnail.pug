mixin thumbnail-classic(obj)
  // Thumbnail Classic
  article.thumbnail.thumbnail-classic(class=obj.mod)
    .thumbnail-classic-figure
      +jpg(obj.nameImg + '-' + obj.numberImg + '-' + obj.sizeImg)

    .thumbnail-classic-caption
      .thumbnail-classic-title-wrap
        a.icon.fl-bigmug-line-zoom60(href='images/' + (obj.nameImgOriginal ? obj.nameImgOriginal : obj.nameImg + '-' + (obj.numberImgOriginal ? obj.numberImgOriginal : obj.numberImg)) + '-1200x800-original.jpg' data-lightgallery='item')
          +jpg(obj.nameImg + '-' + obj.numberImg + '-' + obj.sizeImg)
        h5.thumbnail-classic-title: a(href='#')= obj.title || 'Project #1'
      p.thumbnail-classic-text We work hard on every app to deliver top-notch features with great UI that you won’t find anywhere else.

mixin thumbnail-modern(obj)
  // Thumbnail Modern
  article.thumbnail.thumbnail-modern(class=obj.mod)
    a.thumbnail-modern-figure(href='images/' + (obj.nameImgOriginal ? obj.nameImgOriginal : obj.nameImg + '-' + (obj.numberImgOriginal ? obj.numberImgOriginal : obj.numberImg)) + '-1200x800-original.jpg' data-lightgallery='item')
      +jpg(obj.nameImg + '-' + obj.numberImg + '-' + obj.sizeImg)

    .thumbnail-modern-caption
      h5.thumbnail-modern-title: a(href='#')=obj.title
      p.thumbnail-modern-subtitle=obj.subtitle

mixin thumbnail-creative(obj)
  // Thumbnail Modern
  article.thumbnail.thumbnail-creative(class=obj.mod)&attributes(attributes)
    a.thumbnail-creative-figure(href='images/' + (obj.nameImgOriginal ? obj.nameImgOriginal : obj.nameImg + '-' + (obj.numberImgOriginal ? obj.numberImgOriginal : obj.numberImg)) + '-1200x800-original.jpg' data-lightgallery='item')
      +jpg(obj.nameImg + '-' + obj.numberImg + '-' + obj.sizeImg)

    .thumbnail-creative-caption
      h5.thumbnail-creative-title: a(href='#')=obj.title
      .thumbnail-creative-time
        time(datetime=obj.time.datetime)=obj.time.dateText
      .thumbnail-creative-button
        a.button.button-md.button-white(href='#') Read more

mixin thumbnail-mary(obj)
  // Thumbnail Classic
  article.thumbnail.thumbnail-mary(class=obj.mod)&attributes(attributes)
    .thumbnail-mary-figure: +jpg(obj.nameImg + '-' + obj.numberImg + '-' + obj.sizeImg)

    .thumbnail-mary-caption
      a.icon.fl-bigmug-line-zoom60(href='images/' + (obj.nameImgOriginal ? obj.nameImgOriginal : obj.nameImg + '-' + (obj.numberImgOriginal ? obj.numberImgOriginal : obj.numberImg)) + '-1200x800-original.jpg' data-lightgallery='item')
        +jpg(obj.nameImg + '-' + obj.numberImg + '-' + obj.sizeImg)
      if(obj.titleNone == true)
      else
        if(obj.thumbnailSmall == true)
          h6.thumbnail-mary-title: a(href='#')= 'Project #' + (obj.numberProject ? obj.numberProject : obj.numberImg)
        else
          h5.thumbnail-mary-title: a(href='#')= 'Project #' + (obj.numberProject ? obj.numberProject : obj.numberImg)
  if(obj.nameProject)
    .thumbnail-mary-description
      h4.thumbnail-mary-project: a(href='#')=obj.nameProject
      span.thumbnail-mary-decor
      h5.thumbnail-mary-time
        time(datetime=obj.datetime)=obj.time
